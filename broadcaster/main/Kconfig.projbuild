menu "CSI Broadcaster Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi password (WPA or WPA2).

    config OTA_SERVER_URL
        string "OTA Server URL"
        default "http://192.168.1.100:8070"
        help
            Base URL of the OTA server (e.g., http://192.168.1.100:8070).
            The device will fetch /version/broadcaster and /firmware/broadcaster.

    config LED_GPIO
        int "Status LED GPIO"
        default 2
        range 0 34
        help
            GPIO number for the status LED.

endmenu
